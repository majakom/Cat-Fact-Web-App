@model CatFact.Domain.Entities.CatFactEntity

@{
    ViewData["Title"] = "Cat Facts Generator";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-body p-5 text-center">

                <h1 class="mb-3">Cat Fact Generator</h1>

                <p class="text-muted mb-4">
                    Click the button to discover a random cat fact and save it locally.
                </p>

                <form asp-controller="CatFact" asp-action="Generate" method="post">
                    <button class="btn btn-primary btn-lg w-100 rounded-3">
                        Generate Cat Fact
                    </button>
                </form>

                @if (Model != null)
                {
                    <hr class="my-4" />

                    <div class="p-4 bg-light rounded-3 text-start shadow-sm">

                        <h5 class="mb-2">Latest Fact</h5>

                        <p class="mb-2 fs-5">
                            @Model.Fact
                        </p>

                        <span class="badge bg-secondary">
                            Length: @Model.Length characters
                        </span>

                    </div>
                }

            </div>
        </div>

    </div>
</div>